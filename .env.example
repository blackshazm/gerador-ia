# Configurações de Provedores de IA para a Tríade Studio
# Google AI Studio (Gemini Free Tier Oficial: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Provedores alternativos
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Provedor padrão: gemini | openrouter | nvidia | ollama
DEFAULT_LLM_PROVIDER=gemini

# Modelos recomendados:
# Gemini: gemini-2.5-flash | gemini-2.0-flash | gemini-1.5-flash
# OpenRouter: qwen/qwen-2.5-72b-instruct | meta-llama/llama-3.3-70b-instruct | deepseek/deepseek-r1
# NVIDIA: meta/llama-3.1-70b-instruct | nvidia/llama-3.1-nemotron-70b-instruct
# Ollama: qwen2.5:7b-instruct | llama3.1:8b
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434

# fal.ai - Black Forest Labs FLUX.3 (https://fal.ai)
FAL_KEY=sua_chave_fal_aqui
FAL_MODEL=blackforestlabs/flux-3/text-to-image
